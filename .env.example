# Copia este archivo a %APPDATA%\Sonometa\.env (vale para la app instalada y para desarrollo)
# o a la raíz del proyecto (solo desarrollo).
# SUPABASE_URL y SUPABASE_KEY son opcionales: por defecto se usa el proyecto de Sonometa.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key

# Opcional: el token de Discogs se configura desde la app (Preferencias > Discogs...).
# Si se define aquí, solo se usa cuando no hay uno guardado en la app.
DISCOGS_TOKEN=your-discogs-personal-access-token
